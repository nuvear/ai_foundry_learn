# ============================================================
# AI DevTeam — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- Microsoft AI Foundry Project ---
# Option 1 (new format, SDK 2.0+): Full endpoint URL
#   Found in: Foundry Portal → Your Project → Overview → click the copy icon next to "Endpoint"
#   Format: https://<ai-services-account>.services.ai.azure.com/api/projects/<project-name>
AIPROJECT_CONNECTION_STRING=https://<ai-services-account>.services.ai.azure.com/api/projects/<project-name>

# Option 2 (classic format): Semicolon-delimited connection string
#   Found in: Foundry Portal → Your Project → Overview → Project connection string
#   Format: <region>.api.azureml.ms;<subscription-id>;<resource-group>;<project-name>
# AIPROJECT_CONNECTION_STRING=<your-region>.api.azureml.ms;<your-subscription-id>;<your-resource-group>;<your-project-name>

# --- Model Deployment Name ---
# The name you gave your GPT-4o deployment in the Foundry portal
MODEL_DEPLOYMENT_NAME=gpt-4o

# --- Developer Agent Model (Two-Tier Strategy) ---
# Optional: use a stronger model for the Developer agent only.
# The Developer handles the most complex task (multi-file code + bug fixes)
# so a more capable model here reduces Tester rejection loops.
# Recommended: gpt-4.1 (if deployed in your Foundry project)
# Leave blank or remove this line to use MODEL_DEPLOYMENT_NAME for all agents.
# DEVELOPER_MODEL_DEPLOYMENT_NAME=gpt-4.1

# --- Azure Subscription (for Azure CLI operations) ---
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
