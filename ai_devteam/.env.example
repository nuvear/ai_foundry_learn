# ============================================================
# AI DevTeam — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- Microsoft AI Foundry Project ---
# Found in: Foundry Portal → Your Project → Overview → Project connection string
AIPROJECT_CONNECTION_STRING=<your-region>.api.azureml.ms;<your-subscription-id>;<your-resource-group>;<your-project-name>

# --- Model Deployment Name ---
# The name you gave your GPT-4o deployment in the Foundry portal
MODEL_DEPLOYMENT_NAME=gpt-4o

# --- Azure Subscription (for Azure CLI operations) ---
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
